# =============================================================================
# Smart Hive Mind — Production environment template
# =============================================================================
# Copier ce fichier vers .env et remplir TOUTES les valeurs.
# NE JAMAIS committer le vrai .env.
#
# Generation d'une cle JWT securisee :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# --- MongoDB ----------------------------------------------------------------
# URI d'une instance dediee (Atlas, MongoDB Cloud, ou serveur auto-heberge).
# Ne PAS utiliser localhost en production.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart-hive-mind?retryWrites=true&w=majority

# --- JWT --------------------------------------------------------------------
# Secret utilise pour signer les tokens JWT.
# Generer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Blockchain Sepolia -----------------------------------------------------
# URL RPC d'un fournisseur (Infura, Alchemy, etc.)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<YOUR_PROJECT_ID>

# Cle privee du wallet dedie au serveur (NE PAS utiliser la cle de dev).
PRIVATE_KEY=0x<64-hex-chars>

# Adresse du contrat ProofRegistry apres deploiement sur Sepolia.
CONTRACT_ADDRESS=0x<40-hex-chars>

# --- Frontend / CORS --------------------------------------------------------
# Domaine exact du frontend (ex: https://smart-hive-mind.example.com).
# Ne pas utiliser '*' en production.
CORS_ORIGIN=https://smart-hive-mind.example.com

# --- Services internes (URLs) -----------------------------------------------
# Ces URLs sont resolues par Docker Compose en interne ; sur une infra
# differente, les remplacer par les URLs accessibles.
BLOCKCHAIN_SERVICE_URL=http://blockchain-service:4000
IA_DIAGNOSTIC_URL=http://ai-diagnostic:8000
IA_PREDICTIVE_URL=http://ai-predictive:8000
IA_DECISIONNEL_URL=http://ai-decisionnel:8000
IA_CONVERSATIONAL_URL=http://ai-conversational:8000
IA_OPTIMISATION_URL=http://ai-optimisation:8000
IA_AGENTIC_URL=http://ai-agentic:8000
BACKEND_INTERNAL_URL=http://backend:3000

# --- Cle interne backend <-> ai-agentic -------------------------------------
# Mettre la MEME valeur que celle configuree dans ai-agentic.
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=

# --- Google Gemini (services IA) --------------------------------------------
# Cle gratuite obtenue sur https://aistudio.google.com, aucune carte requise.
# Attention aux limites de debit du tier gratuit (variables selon Google,
# verifier https://ai.google.dev/gemini-api/docs/rate-limits)
GEMINI_API_KEY=
