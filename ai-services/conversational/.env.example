# Google Gemini API
# Cle gratuite : https://aistudio.google.com (aucune carte requise)
# Limites de debit : https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=

# Modeles Gemini (valeurs par defaut du service)
# Modele de generation de texte (ask, assist-writing, generate)
GEMINI_LLM_MODEL=gemini-flash-latest
# Modele d'embedding (768 dim)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Persistance de la base vectorielle ChromaDB
# Chemin utilise par l'application (doit correspondre au mount du volume Docker)
CHROMA_PERSIST_DIR=/data/chroma
